# KORG_E_HOME — data root for generated images and config
# Default: ~/.korg-e
KORG_E_HOME="${KORG_E_HOME:-$HOME/.korg-e}"

# Address the backend binds to. Default is loopback only; set this to a
# VPN/Tailscale address to reach the UI from another machine.
KORG_E_HOST="${KORG_E_HOST:-127.0.0.1}"

# Backend port (default 8000)
KORG_E_PORT="${KORG_E_PORT:-8000}"

# Frontend port (dev server, default 5173)
KORG_E_FRONTEND_PORT="${KORG_E_FRONTEND_PORT:-5173}"

# Log level for uvicorn
KORG_E_LOG_LEVEL="${KORG_E_LOG_LEVEL:-info}"

# Generated images and their JSON sidecars. Defaults to $KORG_E_HOME/outputs.
# KORG_E_OUTPUT_DIR="$HOME/korg-e/output"

# HuggingFace cache directory
HF_HOME="${HF_HOME:-$KORG_E_HOME/cache}"

# Accelerator override. Auto-detected as cuda > mps > cpu when unset.
# KORG_E_DEVICE=cuda

# Stream the ~20GB of weights onto the GPU a submodule at a time so they fit
# on a smaller card. Defaults on for cuda, off elsewhere. On a 5060 Ti this
# costs nothing measurable and is what makes 2048 reachable.
# KORG_E_CPU_OFFLOAD=1

# Attention slicing. Defaults on except for cuda, where offload already caps
# the memory footprint and slicing only costs throughput.
# KORG_E_ATTENTION_SLICING=0

# Model repo. Z-Image-Turbo is far faster but ignores CFG and negative prompts.
# KORG_E_MODEL_ID=Tongyi-MAI/Z-Image

# Live preview cadence, in denoising steps. 0 disables previews — worth doing
# under CPU offload, where each VAE decode evicts the transformer.
# KORG_E_PREVIEW_DECODE_INTERVAL=10
